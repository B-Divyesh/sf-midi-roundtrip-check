{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDI Roundtrip Check",
  "version": "0.1.0",
  "identifier": "in.sociobot.midi-roundtrip-check",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "MIDI Roundtrip Check",
      "width": 1180,
      "height": 820,
      "minWidth": 390,
      "minHeight": 620,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.sociobot.in https://github.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Check MIDI export fidelity locally",
    "longDescription": "Compare MIDI files and inspect channels, pitch bends, controllers and program changes without uploading music.",
    "copyright": "Copyright 2026 Sociobot",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
