{
  "name": "midi-roundtrip-check",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "vite build --mode site --outDir dist/site && node scripts/sync-release-manifest.mjs dist/site/latest.json",
    "build:app": "vite build --mode app --outDir dist/app",
    "preview:site": "vite preview --outDir dist/site --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
